{
    "configurations": [
        {
            "name": "Mac-Clang",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/platform/*",
                "${workspaceFolder}*/engine/*",
                "${workspaceFolder}/libs/imgui/*",
                "${workspaceFolder}*/../libs/imgui/*"
            ],
            "defines": [],
            "macFrameworkPath": [
                "/System/Library/Frameworks",
                "/Library/Frameworks"
            ],
            "compilerPath": "/usr/bin/clang++",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "clang-x64"
        }
    ],
    "version": 4
}